  modalTitle: { color: '#FFFFFF', fontSize: 16, fontWeight: '900' },
  modalClose: { paddingVertical: 8, paddingHorizontal: 12, borderRadius: 12, backgroundColor: 'rgba(255,255,255,0.06)', borderWidth: 1, borderColor: 'rgba(255,255,255,0.10)' },
