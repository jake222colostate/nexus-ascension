    borderColor: 'rgba(255,255,255,0.10)',
  },
  navText: { color: '#D7E1FF', fontSize: 12, fontWeight: '900' },
  upBtn: { backgroundColor: 'rgba(91,124,255,0.20)', borderColor: 'rgba(91,124,255,0.45)' },
  upText: { color: '#FFFFFF' },

  actionsRow: { flexDirection: 'row', gap: 10 },
