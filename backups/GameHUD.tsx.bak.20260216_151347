  toastText: { color: '#D7E1FF', fontSize: 12, fontWeight: '800', textAlign: 'center' },

  modalBg: { flex: 1, backgroundColor: 'rgba(0,0,0,0.72)', justifyContent: 'center', padding: 16 },
  modalCard: { backgroundColor: '#0F172A', borderRadius: 18, borderWidth: 1, borderColor: 'rgba(255,255,255,0.12)', overflow: 'hidden' },
