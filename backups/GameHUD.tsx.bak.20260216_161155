import React, { useMemo } from 'react';
import { Modal, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';

type HudButton =
  | {
      kind: 'press';
      label: string;
      onPress: () => void;
      disabled?: boolean;
    }
  | {
      kind: 'hold';
      label: string;
      activeLabel: string;
      active: boolean;
      onHoldStart: () => void;
      onHoldEnd: () => void;
      disabled?: boolean;
    };

type NavButton = { label: string; onPress: () => void };

export default function GameHUD(props: {
  title: string;
  leftSub?: string;
  rightLines?: string[];
  navButtons?: NavButton[];
  buttons?: HudButton[];
  toast?: string;

  onOpenUpgrades?: () => void;

  upgradesOpen?: boolean;
  onCloseUpgrades?: () => void;
  upgradesTitle?: string;
  upgradesBody?: React.ReactNode;
}) {
  const rightLines = props.rightLines ?? [];
  const buttons = props.buttons ?? [];
  const navButtons = props.navButtons ?? [];

  const showUpgrades = !!props.upgradesOpen;
  const upgradesTitle = props.upgradesTitle ?? 'Upgrades';
  const hasUpgrades = !!props.onOpenUpgrades;

  const topRight = useMemo(() => rightLines.slice(0, 3), [rightLines]);

  return (
    <SafeAreaView pointerEvents="box-none" style={styles.safe}>
      {/* TOP BAR */}
      <View pointerEvents="box-none" style={styles.topWrap}>
        <View style={styles.topBar}>
          <View style={styles.topLeft}>
            <Text numberOfLines={1} style={styles.title}>{props.title}</Text>
            {!!props.leftSub && <Text numberOfLines={1} style={styles.sub}>{props.leftSub}</Text>}
          </View>

          <View style={styles.topRight}>
            {topRight.map((t, i) => (
              <View key={i} style={styles.chip}>
                <Text numberOfLines={1} style={styles.chipText}>{t}</Text>
              </View>
            ))}
          </View>
        </View>

        {!!props.toast && (
          <View style={styles.toastWrap}>
            <Text style={styles.toastText}>{props.toast}</Text>
          </View>
        )}
      </View>

      {/* BOTTOM CONTROLS */}
      <View pointerEvents="box-none" style={styles.bottomWrap}>
        <View style={styles.bottomPanel}>
          {/* NAV ROW */}
          {(navButtons.length > 0 || hasUpgrades) && (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.navRow}
            >
              {navButtons.map((b, i) => (
                <Pressable
                  key={i}
                  onPress={b.onPress}
                  style={({ pressed }) => [styles.navBtn, pressed && styles.pressed]}
                >
                  <Text style={styles.navBtnText}>{b.label}</Text>
                </Pressable>
              ))}

              {hasUpgrades && (
                <Pressable
                  onPress={props.onOpenUpgrades}
                  style={({ pressed }) => [styles.upgradesBtn, pressed && styles.pressed]}
                >
                  <Text style={styles.upgradesBtnText}>Upgrades</Text>
                </Pressable>
              )}
            </ScrollView>
          )}

          {/* ACTION ROW */}
          {buttons.length > 0 && (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.actionRow}
            >
              {buttons.map((b, i) => {
                if (b.kind === 'press') {
                  return (
                    <Pressable
                      key={i}
                      disabled={!!b.disabled}
                      onPress={b.onPress}
                      style={({ pressed }) => [
                        styles.actionBtn,
                        b.disabled && styles.disabled,
                        pressed && styles.pressed,
                      ]}
                    >
                      <Text style={styles.actionBtnText}>{b.label}</Text>
                    </Pressable>
                  );
                }
                return (
                  <Pressable
                    key={i}
                    disabled={!!b.disabled}
                    onPressIn={() => !b.disabled && b.onHoldStart()}
                    onPressOut={() => !b.disabled && b.onHoldEnd()}
                    style={({ pressed }) => [
                      styles.actionBtn,
                      b.active && styles.activeHold,
                      b.disabled && styles.disabled,
                      pressed && styles.pressed,
                    ]}
                  >
                    <Text style={styles.actionBtnText}>{b.active ? b.activeLabel : b.label}</Text>
                  </Pressable>
                );
              })}
            </ScrollView>
          )}

          {/* FALLBACK UPGRADES BUTTON (no nav + no actions) */}
          {navButtons.length === 0 && buttons.length === 0 && hasUpgrades && (
            <View style={{ marginTop: 8 }}>
              <Pressable
                onPress={props.onOpenUpgrades}
                style={({ pressed }) => [styles.upgradesBtnSolo, pressed && styles.pressed]}
              >
                <Text style={styles.upgradesBtnText}>Upgrades</Text>
              </Pressable>
            </View>
          )}
        </View>
      </View>

      {/* UPGRADES MODAL */}
      <Modal visible={showUpgrades} transparent animationType="fade" onRequestClose={props.onCloseUpgrades}>
        <View style={styles.modalOverlay}>
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <Text style={styles.modalTitle}>{upgradesTitle}</Text>
              <Pressable onPress={props.onCloseUpgrades} style={({ pressed }) => [styles.closeBtn, pressed && styles.pressed]}>
                <Text style={styles.closeBtnText}>Close</Text>
              </Pressable>
            </View>

            <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.modalBody}>
              {props.upgradesBody}
            </ScrollView>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

