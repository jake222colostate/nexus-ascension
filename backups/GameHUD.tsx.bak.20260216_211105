import React, { useMemo } from 'react';
import { Modal, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';

type NavButton = { label: string; onPress: () => void };

export default function GameHUD(props: {
  title: string;
  leftSub?: string;
  rightLines?: string[];
  navButtons?: NavButton[];
  toast?: string;

  upgradesOpen?: boolean;
  onCloseUpgrades?: () => void;
  upgradesTitle?: string;
  upgradesBody?: React.ReactNode;
}) {
  const rightLines = props.rightLines ?? [];
  const navButtons = props.navButtons ?? [];
  const topRight = useMemo(() => rightLines.slice(0, 3), [rightLines]);
  const showUpgrades = !!props.upgradesOpen;

  return (
    <SafeAreaView pointerEvents="box-none" style={styles.safe}>
      <View pointerEvents="box-none" style={styles.topWrap}>
        <View style={styles.topBar}>
          <View style={styles.leftStack}>
            {!!props.title && (
              <View style={styles.titlePill}>
                <Text style={styles.titleText} numberOfLines={1}>
                  {props.title}
                </Text>
              </View>
            )}
            {!!props.leftSub && (
              <View style={styles.subPill}>
                <Text style={styles.subText} numberOfLines={1}>
                  {props.leftSub}
                </Text>
              </View>
            )}
          </View>

          <View style={styles.rightStack}>
            {topRight.map((t, i) => (
              <View key={i} style={styles.chip}>
                <Text style={styles.chipText} numberOfLines={1}>
                  {t}
                </Text>
              </View>
            ))}
          </View>
        </View>

        {navButtons.length > 0 && (
          <ScrollView
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={styles.navRow}
            pointerEvents="box-none"
          >
            {navButtons.map((b, i) => (
              <Pressable key={i} style={styles.navBtn} onPress={b.onPress}>
                <Text style={styles.navText} numberOfLines={1}>
                  {b.label}
                </Text>
              </Pressable>
            ))}
          </ScrollView>
        )}

        {!!props.toast && (
          <View style={styles.toastPill} pointerEvents="none">
            <Text style={styles.toastText} numberOfLines={2}>
              {props.toast}
            </Text>
          </View>
        )}
      </View>

      <Modal visible={showUpgrades} transparent animationType="fade" onRequestClose={props.onCloseUpgrades}>
        <View style={styles.modalBg}>
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <Text style={styles.modalTitle}>{props.upgradesTitle ?? 'Upgrades'}</Text>
              <Pressable style={styles.modalClose} onPress={props.onCloseUpgrades}>
                <Text style={styles.modalCloseText}>Close</Text>
              </Pressable>
            </View>
            <ScrollView contentContainerStyle={styles.modalBody} keyboardShouldPersistTaps="handled">
              {props.upgradesBody}
            </ScrollView>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safe: { position: 'absolute', top: 0, left: 0, right: 0, bottom: 0 },

  topWrap: { position: 'absolute', top: 0, left: 0, right: 0, paddingHorizontal: 12, paddingTop: 6 },
  topBar: {
    flexDirection: 'row',
    alignItems: 'flex-start',
    justifyContent: 'space-between',
    paddingVertical: 10,
  },

  leftStack: { flexShrink: 1, gap: 8 },
  rightStack: { flexShrink: 0, alignItems: 'flex-end', gap: 8 },

  titlePill: {
    maxWidth: 260,
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 999,
    backgroundColor: 'rgba(14, 18, 28, 0.68)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.10)',
  },
  titleText: { color: '#EAF0FF', fontWeight: '900', fontSize: 14, letterSpacing: 0.6 },

  subPill: {
    maxWidth: 280,
    paddingVertical: 8,
    paddingHorizontal: 12,
    borderRadius: 999,
    backgroundColor: 'rgba(14, 18, 28, 0.62)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.10)',
  },
  subText: { color: '#D7E1FF', fontSize: 12, fontWeight: '800' },

  chip: {
    maxWidth: 170,
    paddingVertical: 8,
    paddingHorizontal: 12,
    borderRadius: 999,
    backgroundColor: 'rgba(14, 18, 28, 0.62)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.10)',
  },
  chipText: { color: '#D7E1FF', fontSize: 12, fontWeight: '900' },

  navRow: { flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 8, paddingRight: 12 },
  navBtn: {
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 999,
    backgroundColor: 'rgba(10, 14, 22, 0.72)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.12)',
  },
  navText: { color: '#EAF0FF', fontWeight: '900', fontSize: 12, letterSpacing: 0.3 },

  toastPill: {
    marginTop: 8,
    maxWidth: 320,
    paddingVertical: 8,
    paddingHorizontal: 12,
    borderRadius: 999,
    backgroundColor: 'rgba(14, 18, 28, 0.68)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.10)',
    alignSelf: 'flex-start',
  },
  toastText: { color: '#D7E1FF', fontSize: 12, fontWeight: '800' },

  modalBg: { flex: 1, backgroundColor: 'rgba(0,0,0,0.65)', justifyContent: 'center', padding: 16 },
  modalCard: {
    borderRadius: 18,
    backgroundColor: '#0F1626',
