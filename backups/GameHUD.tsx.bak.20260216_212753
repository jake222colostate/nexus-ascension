import React, { useMemo } from 'react';
import { Modal, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';

type HudButton =
  | {
      kind: 'press';
      label: string;
      onPress: () => void;
      disabled?: boolean;
    }
  | {
      kind: 'hold';
      label: string;
      activeLabel: string;
      active: boolean;
      onHoldStart: () => void;
      onHoldEnd: () => void;
      disabled?: boolean;
    };

type NavButton = { label: string; onPress: () => void };

export default function GameHUD(props: {
  title: string;
  leftSub?: string;
  rightLines?: string[];
  navButtons?: NavButton[];
  buttons?: HudButton[];
  toast?: string;

  onOpenUpgrades?: () => void;

  upgradesOpen?: boolean;
  onCloseUpgrades?: () => void;
  upgradesTitle?: string;
  upgradesBody?: React.ReactNode;
}) {
  const rightLines = props.rightLines ?? [];
  const navButtons = props.navButtons ?? [];
  const buttons = props.buttons ?? [];
  const topRight = useMemo(() => rightLines.slice(0, 3), [rightLines]);
  const showUpgrades = !!props.upgradesOpen;
  const hasUpgrades = !!props.onOpenUpgrades;

  return (
    <SafeAreaView pointerEvents="box-none" style={styles.safe}>
      {/* TOP */}
      <View pointerEvents="box-none" style={styles.topWrap}>
        <View style={styles.topBar}>
          <View style={styles.leftStack}>
            {!!props.title && (
              <View style={styles.titlePill}>
                <Text style={styles.titleText} numberOfLines={1}>
                  {props.title}
                </Text>
              </View>
            )}
            {!!props.leftSub && (
              <View style={styles.subPill}>
                <Text style={styles.subText} numberOfLines={1}>
                  {props.leftSub}
                </Text>
              </View>
            )}
          </View>

          <View style={styles.rightStack}>
            {topRight.map((t, i) => (
              <View key={i} style={styles.chip}>
                <Text style={styles.chipText} numberOfLines={1}>
                  {t}
                </Text>
              </View>
            ))}
          </View>
        </View>

        {/* WORLD TABS (TOP ONLY) */}
        {navButtons.length > 0 && (
          <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.navRow} pointerEvents="box-none">
            {navButtons.map((b, i) => (
              <Pressable key={i} style={styles.navBtn} onPress={b.onPress}>
                <Text style={styles.navText} numberOfLines={1}>
                  {b.label}
                </Text>
              </Pressable>
            ))}
          </ScrollView>
        )}

        {!!props.toast && (
          <View style={styles.toastPill} pointerEvents="none">
            <Text style={styles.toastText} numberOfLines={2}>
              {props.toast}
            </Text>
          </View>
        )}
      </View>

      {/* BOTTOM ACTIONS (NO WORLD BUTTONS HERE) */}
      {(buttons.length > 0 || hasUpgrades) && (
        <View pointerEvents="box-none" style={styles.bottomWrap}>
          <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.actionsRow}>
            {buttons.map((b, i) => {
              if (b.kind === 'press') {
                return (
                  <Pressable
                    key={i}
                    disabled={!!b.disabled}
                    onPress={b.onPress}
                    style={({ pressed }) => [
                      styles.actionBtn,
                      b.disabled && styles.disabled,
                      pressed && styles.pressed,
                    ]}
                  >
                    <Text style={styles.actionText} numberOfLines={1}>
                      {b.label}
                    </Text>
                  </Pressable>
                );
              }

              return (
                <Pressable
                  key={i}
                  disabled={!!b.disabled}
                  onPressIn={() => !b.disabled && b.onHoldStart()}
                  onPressOut={() => !b.disabled && b.onHoldEnd()}
                  style={({ pressed }) => [
                    styles.actionBtn,
                    b.active && styles.actionBtnActive,
                    b.disabled && styles.disabled,
                    pressed && styles.pressed,
                  ]}
                >
                  <Text style={styles.actionText} numberOfLines={1}>
                    {b.active ? b.activeLabel : b.label}
                  </Text>
                </Pressable>
              );
            })}

            {hasUpgrades && (
              <Pressable
                onPress={props.onOpenUpgrades}
                style={({ pressed }) => [styles.actionBtn, styles.upBtn, pressed && styles.pressed]}
              >
                <Text style={[styles.actionText, styles.upText]} numberOfLines={1}>
                  Upgrades
                </Text>
              </Pressable>
            )}
          </ScrollView>
        </View>
      )}

      {/* UPGRADES MODAL */}
      <Modal visible={showUpgrades} transparent animationType="fade" onRequestClose={props.onCloseUpgrades}>
        <View style={styles.modalBg}>
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <Text style={styles.modalTitle}>{props.upgradesTitle ?? 'Upgrades'}</Text>
              <Pressable style={styles.modalClose} onPress={props.onCloseUpgrades}>
                <Text style={styles.modalCloseText}>Close</Text>
              </Pressable>
            </View>
            <ScrollView contentContainerStyle={styles.modalBody} keyboardShouldPersistTaps="handled">
              {props.upgradesBody}
            </ScrollView>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

